rules_version = '2';

// ⚠️ DEPLOY ORDER — READ BEFORE `firebase deploy --only firestore:rules`.
//
// This file denies client-side board and session creates outright; the only
// creation paths are the `createBoard` and `createSession` Cloud Functions,
// which write via the Admin SDK and so bypass these rules entirely.
//
// Those functions MUST already be deployed when these rules go live. Deploying
// this file first takes board and session creation down for every user: the
// client path is denied and its replacement does not exist yet. Deploy
// `functions` first, confirm both callables respond, then deploy rules.
//
// Rolling back is the mirror image: roll rules back BEFORE removing the
// functions, never after.
//
// ⚠️ AND IF YOU DO HAVE TO ROLL BACK: restore ONLY the two `allow create` blocks
// (boards and sessions) to their pre-M5 predicates. Do NOT `git revert` the
// commit that introduced them — it landed as one commit, so reverting it would
// also make `plan` client-writable again (handing anyone Pro for a single write)
// and drop the collaborator cap entirely. The create rules are the emergency
// surface; the rest of that commit must stay.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Phase 2 (multi-tenancy). Membership in a workspace, resolved with a single
    // get(). Guarded by exists() so a dangling/typo workspaceId denies rather
    // than erroring. This is the read that the M1 Android time-to-first-paint
    // perf gate watches — keep it to one get() per check.
    function isMemberOfWorkspace(wsId) {
      return wsId != null && wsId != '' &&
        exists(/databases/$(database)/documents/workspaces/$(wsId)) &&
        request.auth.uid in get(/databases/$(database)/documents/workspaces/$(wsId)).data.members;
    }

    // Board access resolves through the parent workspace: a board's members are a
    // subset of its workspace's members. Migration-tolerant — a legacy board with
    // no workspaceId falls back to the board-only gate so existing testers don't
    // 403 mid-migration.
    // TODO(phase-9-cutover): remove the `board.workspaceId == null` fallback once
    // the migration has stamped every board and the staging soak closes.
    // `.get(key, null)` so a legacy doc that lacks the field reads as null instead
    // of erroring (reading a missing map property is a hard error in rules).
    function inBoardWorkspace(board) {
      return board.get('workspaceId', null) == null ||
        isMemberOfWorkspace(board.get('workspaceId', null));
    }

    function isBoardMember(boardId) {
      let board = get(/databases/$(database)/documents/boards/$(boardId)).data;
      return isSignedIn() &&
        request.auth.uid in board.members &&
        inBoardWorkspace(board);
    }

    function isBoardAdmin(boardId) {
      let board = get(/databases/$(database)/documents/boards/$(boardId)).data;
      return isSignedIn() && (
        request.auth.uid == board.ownerId ||
        request.auth.uid == board.adminId
      ) && inBoardWorkspace(board);
    }

    // Phase 6 (per-board roles). A member's role in the board's workspace, or null
    // when the workspace is missing or the user isn't a member of it. `.get(uid,
    // null)` on the members map so a non-member reads as null rather than erroring.
    function workspaceRoleOf(wsId, uid) {
      return wsId != null && wsId != '' &&
        exists(/databases/$(database)/documents/workspaces/$(wsId)) ?
        get(/databases/$(database)/documents/workspaces/$(wsId)).data.members.get(uid, null) :
        null;
    }

    // Effective-editor check, mirroring boardService.effectiveBoardRole. Editor =
    // an explicit 'editor' override, OR (no override AND a workspace owner/admin/
    // member). The floor rule is enforced by the `wsRole != 'viewer'` guard: a
    // workspace viewer is never an editor, even with an 'editor' override.
    function isEffectiveEditor(board, uid) {
      let wsRole = workspaceRoleOf(board.workspaceId, uid);
      let override = board.get('roles', {}).get(uid, null);
      return wsRole != null && wsRole != 'viewer' && (
        override == 'editor' ||
        (override == null && wsRole in ['owner', 'admin', 'member'])
      );
    }

    // Whether the caller may write canvas content on a board (Phase 6). The board
    // owner and members of a legacy (no-workspace) board edit unconditionally,
    // preserving pre-Phase-6 behavior during the migration window.
    // TODO(phase-9-cutover): drop the `workspaceId == null` legacy-editor clause.
    function isBoardEditor(boardId) {
      let board = get(/databases/$(database)/documents/boards/$(boardId)).data;
      return isSignedIn() &&
        request.auth.uid in board.members &&
        inBoardWorkspace(board) && (
          request.auth.uid == board.ownerId ||
          board.get('workspaceId', null) == null ||
          isEffectiveEditor(board, request.auth.uid)
        );
    }

    // Effective-commenter check (Phase 7), mirroring boardService.canCommentBoardRole
    // composed with effectiveBoardRole. Commenter+ = an explicit editor/commenter
    // override, OR (no override AND a workspace owner/admin/member). A workspace
    // viewer with no override resolves to viewer and CANNOT comment; a workspace
    // viewer with a commenter/editor override is floor-capped to commenter and CAN.
    function isEffectiveCommenter(board, uid) {
      let wsRole = workspaceRoleOf(board.workspaceId, uid);
      let override = board.get('roles', {}).get(uid, null);
      return wsRole != null && (
        override == 'editor' || override == 'commenter' ||
        (override == null && wsRole in ['owner', 'admin', 'member'])
      );
    }

    // Whether the caller may comment on a board (Phase 7 — comments require the
    // commenter role, a strict superset of editors). Owner + legacy-board members
    // comment unconditionally, mirroring isBoardEditor's migration tolerance.
    // TODO(phase-9-cutover): drop the `workspaceId == null` legacy clause.
    function isBoardCommenter(boardId) {
      let board = get(/databases/$(database)/documents/boards/$(boardId)).data;
      return isSignedIn() &&
        request.auth.uid in board.members &&
        inBoardWorkspace(board) && (
          request.auth.uid == board.ownerId ||
          board.get('workspaceId', null) == null ||
          isEffectiveCommenter(board, request.auth.uid)
        );
    }

    // Phase 10 anti-spam. A mention notification may be written to a user's inbox
    // only when BOTH the actor (caller) and the recipient belong to the workspace of
    // the board the mention is on. Mention candidates are sourced from workspace
    // members (the board-screen autocomplete reads `workspace.members`), so this
    // matches every legitimate mention exactly while denying a signed-in user the
    // ability to plant notifications in arbitrary inboxes across tenants. A legacy
    // board (no workspaceId) resolves to null and is denied — consistent with the
    // client never generating mentions on a workspace-less board.
    function notifBoardWorkspaceShared(boardId, recipientUid) {
      let wsId = exists(/databases/$(database)/documents/boards/$(boardId))
        ? get(/databases/$(database)/documents/boards/$(boardId)).data.get('workspaceId', null)
        : null;
      return isMemberOfWorkspace(wsId) && workspaceRoleOf(wsId, recipientUid) != null;
    }

    // Month 4, Phase 8 — embed identity. An embed viewer is a visitor with no
    // account who exchanged a short-lived signed embed token for a Firebase custom
    // token carrying these claims (functions/src/callable/exchangeEmbedToken.ts).
    // The claim is board-scoped: it grants READ to exactly the one board it names
    // and that board's canvas — never another board. This is the token-scoped embed
    // read path the roadmap requires be explicitly rules-tested. `.get(..,default)`
    // so a normal user's token (no embed claims) reads as false, not an error.
    //
    // NOTE: this predicate is scope-agnostic on purpose — it is the "is an embed
    // identity for this board" test, and both scopes read. Writes are gated by
    // isEmbedEditor below, never by this one.
    //
    // isEmbedIdentity is the board-agnostic form: "this caller arrived through the
    // embed exchange at all". Used to keep embed identities out of paths that gate
    // only on being signed in — the board invite-code self-join arm below.
    function isEmbedIdentity() {
      return isSignedIn() && request.auth.token.get('embed', false) == true;
    }

    function isEmbedViewer(boardId) {
      return isSignedIn() &&
        request.auth.token.get('embed', false) == true &&
        request.auth.token.get('embedBoardId', '') == boardId;
    }

    // Month 5 — editable embed identity. The same custom-token identity, but
    // exchanged from a v2 token that carried a HOST-ASSERTED subject, so its uid is
    // namespaced per issuer (`embed:<iss>:<sub>`) and its writes attribute to a
    // stable person rather than to a shared anonymous per-board uid. A v1 token can
    // never produce this: verifyEmbedToken rejects v1 + edit outright.
    //
    // EXACTLY what it grants, on exactly the one board the claim names:
    //   - write to paths, notes, textElements, shapes and snapshots;
    //   - read presence/cursors, and write its OWN presence/cursor doc.
    //
    // What it does NOT grant, deliberately. This identity is not a board member and
    // must never become one:
    //   - the board document (title, members, roles, invite code) stays read-only,
    //     and the invite-code self-join arm explicitly excludes it (isEmbedIdentity);
    //   - COMMENTS stay member-only. The roadmap's motivation for host-asserted
    //     identity names comments and the activity feed, but neither ships here:
    //     commenting writes an authorId and can fan out notifications, and the
    //     activity feed is workspace-scoped and so unreachable to a board-scoped
    //     claim. Read this list, not the roadmap, for what is wired.
    //   - IMAGES and AUDIO are excluded even though they are canvas content: their
    //     bytes live in Cloud Storage, gated on isBoardMember (storage.rules), which
    //     an embed identity is not. Granting the Firestore document alone would let
    //     an embed editor create an element pointing at an object it can neither
    //     upload nor read back — a broken element, not a feature. Re-add here only
    //     together with a matching storage.rules predicate.
    //   - every other board is unreachable, same as a view embed.
    //
    // The subject behind this uid is asserted by the host, not proved. See the
    // trust-model note at the top of functions/src/embed/token.ts: a compromised
    // allowlisted host can impersonate its OWN users to each other; it cannot reach
    // a real B.O.A.R.D account or a board its token does not name.
    function isEmbedEditor(boardId) {
      return isEmbedViewer(boardId) &&
        request.auth.token.get('embedScope', '') == 'edit';
    }

    // ── M5 seat cap ───────────────────────────────────────────────────────────
    // The per-board collaborator cap. Enforced here as a rules predicate rather
    // than in a Cloud Function because the invite-code self-join path is a client
    // `update` to `members`, not a create — a callable would leave that door open.
    // This is the only enforcement point for `collaboratorsPerBoard`; nothing on
    // the Functions side reads that limit today.
    //
    // ⚠️ DUPLICATED NUMBERS. These three must equal
    // `PLAN_LIMITS[*].collaboratorsPerBoard` in functions/src/billing/limits.ts,
    // which is the source of truth. Rules cannot import TypeScript, so the
    // agreement is held by a drift test — `functions/src/__tests__/limits.test.ts`
    // parses this map as text and fails if the two disagree in either direction.
    // Edit both files together.
    function seatCaps() {
      return {'free': 4, 'pro': 25, 'edu': 100};
    }

    // The workspace's plan. Missing workspace, missing field, or a legacy board
    // with no workspaceId all resolve to 'free' — an unreadable or unknown plan
    // fails closed to the smallest cap, matching `limitFor`'s fallback on the
    // Functions side. `plan` itself is not client-writable (see the workspaces
    // rules below), so this value is trustworthy.
    function planOfWorkspace(wsId) {
      return wsId != null && wsId != '' &&
        exists(/databases/$(database)/documents/workspaces/$(wsId)) ?
        get(/databases/$(database)/documents/workspaces/$(wsId)).data.get('plan', 'free') : 'free';
    }

    // An unrecognized plan string falls back to the free cap, same as limitFor.
    function planSeatLimit(wsId) {
      return seatCaps().get(planOfWorkspace(wsId), seatCaps().free);
    }

    // Whether a board `update` leaves `members` within the plan's cap. The cap
    // counts the whole `members` array (the owner included) — that is the unit
    // both this rule and the limits table use.
    //
    // The plan is resolved from the STORED workspaceId (`board`, not `next`), so a
    // write cannot re-parent a board into a richer workspace and be measured
    // against that workspace's cap in the same operation. `workspaceIdUnchanged`
    // below closes re-parenting outright; this makes the cap safe even if that
    // rule is ever relaxed.
    //
    // The second clause permits any update that does not GROW the membership —
    // shrinking it, leaving it the same size, or swapping one member for another.
    // It exists for the board that is ALREADY over cap (what a pro → free
    // downgrade leaves behind): without it such a board freezes permanently, and
    // a member could not even leave. A same-size swap is allowed as a consequence;
    // it never increases the seat count, so it is not a way around the cap.
    function withinSeatCap(board, next) {
      let nextSize = next.get('members', []).size();
      return nextSize <= planSeatLimit(board.get('workspaceId', null)) ||
        nextSize <= board.get('members', []).size();
    }

    // A board's `workspaceId` is immutable from the client: a board that has one
    // keeps it, and a legacy board that has none stays that way. Only the ADMIN
    // arm of the board `update` rule below can write arbitrary fields, so without
    // this it could re-parent a board — and that breaks two gates at once:
    //
    //   • The board cap. `countBoards` (functions/src/billing/usage.ts) counts
    //     `boards where workspaceId == ws`, so a patched client could unset
    //     `workspaceId` on each of its 5 boards and they would STAY USABLE —
    //     `inBoardWorkspace` treats a null workspaceId as permitted and the board
    //     list deliberately keeps such boards visible. The count would then return
    //     0 and the callable would grant 5 more boards, repeatable indefinitely.
    //   • The seat cap, if it ever resolved the plan from the incoming write
    //     rather than the stored doc (see `withinSeatCap` above).
    //
    // Safe for every real path: no client writes this field on update
    // (boardService.updateBoard accepts only title/adminId/backgroundTemplate),
    // creates are Cloud-Function-only, and the Phase 9 backfill stamps it via the
    // Admin SDK, which bypasses these rules. This pins the TRANSITION, so existing
    // legacy boards keep working and the backfill is unaffected.
    function workspaceIdUnchanged(board, next) {
      return next.get('workspaceId', null) == board.get('workspaceId', null);
    }

    // ── M6 plan gates (feature tiers other than the seat cap) ──────────────────
    // A board's plan, resolved through the SAME `planOfWorkspace` helper the M5
    // seat cap uses above — never a second way to read `plan`. A legacy board
    // (no workspaceId) resolves through planOfWorkspace's own null handling to
    // 'free', same as everywhere else that helper is used.
    function planOfBoard(boardId) {
      return planOfWorkspace(get(/databases/$(database)/documents/boards/$(boardId)).data.get('workspaceId', null));
    }

    // Voice notes are Pro-tier (ROADMAP.md:583-587). An ALLOW-list of paid
    // tiers, not `planOfBoard(boardId) != 'free'`: an unrecognized plan string
    // (a future tier, corrupt data) must fail CLOSED to "not paid", mirroring
    // `planSeatLimit`'s own fallback-to-free behavior above. This is a
    // deliberate, narrow divergence from the advisory client check
    // (`canRecordVoiceNotes` in src/services/audioService.ts, which tests
    // `plan !== 'free'` instead) — the two agree on every real `Plan` value
    // and differ only on data neither should ever see.
    function boardOnPaidPlan(boardId) {
      return planOfBoard(boardId) in ['pro', 'edu'];
    }

    // ── users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn();          // any signed-in user can look up profiles (friend search)
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;               // accounts are not deleted client-side

      // private subcollection — only the owner can read/write (used for API keys)
      match /private/{doc} {
        allow read, write: if isOwner(uid);
      }

      // In-app notifications (Phase 10). Only the owner reads their inbox. A mention
      // notification is written by the actor (any signed-in user), so create is gated
      // on the actor being pinned to the caller and the recipient matching the path
      // owner — mirroring the friendRequests trust model (any signed-in user may
      // address one to another, but can't forge the sender). The owner may only flip
      // `read` (mark-as-read); the immutable mention payload can't be edited. Delete
      // is the owner's (dismiss). No one else writes.
      match /notifications/{notificationId} {
        allow read:   if isOwner(uid);
        allow create: if isSignedIn() &&
                        request.resource.data.actorId == request.auth.uid &&
                        request.resource.data.recipientId == uid &&
                        notifBoardWorkspaceShared(request.resource.data.boardId, uid);
        allow update: if isOwner(uid) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if isOwner(uid);
      }
    }

    // ── workspaces ──────────────────────────────────────────────────────────────
    // Phase 1 (multi-tenancy). Membership is the role map keyed by uid; reads/writes
    // gate on membership and resolve from resource.data (no get() — keeps the board
    // time-to-first-paint perf gate clear). Role/membership changes are owner/admin
    // only; ordinary members may rename the workspace. Boards bind to a workspace in
    // Phase 2, where this becomes the root of board access.
    //
    // `plan` is the one field a client may never choose (M5). Every server-side
    // quota gate — checkAiQuota, handleCreateBoard, handleCreateSession, and
    // `planSeatLimit` above — reads it, so a client that could write it could hand
    // itself Pro with a single Firestore write and every one of those gates would
    // agree. Signup legitimately stamps `plan: 'free'`, so `create` permits that
    // value and nothing else; `update` may not touch the field at all, which
    // leaves the Stripe webhook (Admin SDK, bypasses these rules) as the only
    // writer of `plan` after signup. Note the restriction is on the FIELD, not on
    // a field allowlist: every other workspace field (name, members, memberIds,
    // settings, anything added later) keeps its existing role gate untouched.
    //
    // One trap to know about: `affectedKeys()` counts REMOVALS as well as
    // changes, so a full-document `setDoc` that simply omits `plan` is denied too.
    // No client path does that today (every workspace write is an `updateDoc`),
    // and the behaviour is the safe direction — but a future full-overwrite writer
    // would have to carry `plan` through unchanged.
    match /workspaces/{workspaceId} {
      allow read:   if isSignedIn() && request.auth.uid in resource.data.members;
      allow create: if isSignedIn() &&
                      request.resource.data.ownerId == request.auth.uid &&
                      request.resource.data.members[request.auth.uid] == 'owner' &&
                      request.resource.data.get('plan', 'free') == 'free';
      allow update: if isSignedIn() &&
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan']) && (
                      resource.data.members[request.auth.uid] in ['owner', 'admin'] ||
                      (request.auth.uid in resource.data.members &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']))
                    );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerId;

      // Activity feed (Phase 8). Append-only log of workspace/board mutations.
      // Read = workspace membership (resolved from the parent doc, no extra get()
      // for members already loading the workspace). Create requires membership AND
      // the actor pinned to the caller; the event's own workspaceId must match the
      // path so an event can't be planted under a workspace it claims to belong to.
      // No update/delete, ever — the log is immutable (the M5 version-history
      // substrate). This is the "append-only enforced in rules" gate the tests assert.
      match /activity/{eventId} {
        allow read:   if isSignedIn() &&
                        request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members;
        allow create: if isSignedIn() &&
                        request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members &&
                        request.resource.data.actorId == request.auth.uid &&
                        request.resource.data.workspaceId == workspaceId;
        allow update, delete: if false;
      }

      // AI cost telemetry + rate-limit state (Month 4, Phase 1). Written ONLY by
      // Cloud Functions via the Admin SDK (which bypasses these rules) — so every
      // client write is denied here. `aiUsage`/`aiLog` are readable by workspace
      // owner/admins for the usage page (Phase 2); the `aiRate` token bucket is an
      // internal limiter doc no client needs to read. This is the "aiLog/aiUsage
      // reject client writes" gate the rules tests assert.
      match /aiUsage/{period} {
        allow read:  if isSignedIn() &&
                       get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members[request.auth.uid] in ['owner', 'admin'];
        allow write: if false;
      }
      match /aiLog/{callId} {
        allow read:  if isSignedIn() &&
                       get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members[request.auth.uid] in ['owner', 'admin'];
        allow write: if false;
      }
      match /aiRate/{bucketId} {
        allow read, write: if false;
      }

      // Plan metering (M5). Written ONLY by Cloud Functions via the Admin SDK,
      // exactly like aiUsage/aiLog above. Owner/admin read it for the usage page.
      match /usage/{period} {
        allow read:  if isSignedIn() &&
                       get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members[request.auth.uid] in ['owner', 'admin'];
        allow write: if false;
      }
      // Stripe subscription state (M5). The webhook is the only writer; a client
      // that could write here could grant itself Pro.
      match /billing/{docId} {
        allow read:  if isSignedIn() &&
                       get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members[request.auth.uid] in ['owner', 'admin'];
        allow write: if false;
      }
    }

    // ── boards ────────────────────────────────────────────────────────────────
    match /boards/{boardId} {
      // Members + owner can read, but only while they're still in the board's
      // workspace (Phase 2 — board access ⊆ workspace membership); legacy boards
      // with no workspaceId keep the board-only gate. Anyone signed-in can still
      // read a board that has an inviteCode (needed for the join-by-code lookup
      // query) — that public-lookup path is intentionally not workspace-gated.
      allow read:   if (isSignedIn() && (
                      (request.auth.uid == resource.data.ownerId && inBoardWorkspace(resource.data)) ||
                      (request.auth.uid in resource.data.members && inBoardWorkspace(resource.data)) ||
                      resource.data.inviteCode != null
                    )) ||
                    // Phase 8 — a board-scoped embed token grants read-only access.
                    isEmbedViewer(boardId);
      // Creating a board is Cloud-Function-only (functions/src/callable/createBoard.ts).
      // The function reads the live board count and denies past the plan's cap,
      // then writes with the Admin SDK, which bypasses these rules. A client
      // create is denied here because no rules predicate can count a workspace's
      // boards — so leaving the direct path open would make the cap bypassable by
      // a patched bundle or a raw REST call. See the deploy-order warning at the
      // top of this file: the callable must be live before this is deployed.
      //
      // The cap holds because of two rules together: every create goes through
      // the function, AND `workspaceIdUnchanged` pins a board's workspaceId on
      // update. Without the second, a client could unset `workspaceId` on its
      // existing boards to hide them from the function's `countBoards` filter and
      // earn a fresh allowance — see that helper for the full route.
      //
      // Remaining honest caveat: boards that predate the Phase 2 migration have
      // no `workspaceId`, so `countBoards` cannot see them and they don't consume
      // a slot. That undercounts the cap for those accounts until the backfill
      // runs. It is a property of existing data, not a route a client can take.
      allow create: if false;
      // Admin can change anything (incl. the per-board `roles` map — Phase 6);
      // an effective editor can change the shared backgroundTemplate (Phase 12);
      // any member can still touch members/updatedAt (leave/self-join bookkeeping)
      // so a viewer can leave a board; a non-member can self-join via invite code
      // (mirrors the sessions rule).
      //
      // The seat cap gates ALL of those arms, not just the self-join one: the
      // admin/editor/member arms can each grow `members` too (boardService's
      // addMemberById / addMemberByEmail land on them), so capping only self-join
      // would leave the ordinary "share this board" path uncapped. An update that
      // does not grow `members` always satisfies the predicate, so no pre-existing
      // legitimate edit changes behavior.
      //
      // The two trailing predicates are ANDed last on purpose: an unauthorized
      // caller is rejected by the arms without ever paying for `planSeatLimit`'s
      // workspace get(). For an authorized caller the arms have already loaded
      // that same doc, and the rules engine caches document access within one
      // evaluation, so the cap adds no read to the requests that reach it.
      // `workspaceIdUnchanged` comes first of the two because it reads no
      // documents at all.
      allow update: if (
                      isBoardAdmin(boardId) ||
                      (isBoardEditor(boardId) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt', 'backgroundTemplate'])) ||
                      (isBoardMember(boardId) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])) ||
                      (
                        resource.data.inviteCode != null &&
                        // Month 5 — an embed identity may NEVER self-join. Its entry
                        // point is the exchange, which scopes it to exactly one
                        // board; an invite code is a different, broader credential
                        // and this arm gates on nothing but "is signed in". Without
                        // this guard an embed identity (either scope) could join any
                        // invite-coded board whose id it knows — and on a LEGACY
                        // board (no workspaceId) isBoardEditor's null-workspace
                        // disjunct would then make it a full editor of a board it was
                        // never scoped to. Open since Phase 8; closed here because
                        // Month 5 gives an embed identity write powers.
                        !isEmbedIdentity() &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt']) &&
                        request.resource.data.members.hasAll(resource.data.members) &&
                        request.resource.data.members.size() == resource.data.members.size() + 1 &&
                        request.resource.data.members.hasAny([request.auth.uid])
                      )
                    ) &&
                    workspaceIdUnchanged(resource.data, request.resource.data) &&
                    withinSeatCap(resource.data, request.resource.data);
      allow delete: if isBoardAdmin(boardId);

      // Canvas content (paths, notes, textElements, shapes, images, audio, snapshots):
      // any board member reads; only an effective editor writes (Phase 6 —
      // viewer/commenter are read-only on the canvas). This is the "viewer write
      // denied" gate the rules tests assert.
      //
      // Month 5 — an edit-scoped embed identity writes here too. It is the ONLY
      // non-member write path on the canvas, it is board-scoped by its claim, and
      // a read-only ('view') embed is unaffected: isEmbedEditor requires
      // embedScope == 'edit'. NOT extended to images/audio below — see the
      // storage.rules note on isEmbedEditor.
      match /paths/{pathId} {
        allow read:  if isBoardMember(boardId) || isEmbedViewer(boardId);
        allow write: if isBoardEditor(boardId) || isEmbedEditor(boardId);
      }

      match /notes/{noteId} {
        allow read:  if isBoardMember(boardId) || isEmbedViewer(boardId);
        allow write: if isBoardEditor(boardId) || isEmbedEditor(boardId);
      }

      match /textElements/{elementId} {
        allow read:  if isBoardMember(boardId) || isEmbedViewer(boardId);
        allow write: if isBoardEditor(boardId) || isEmbedEditor(boardId);
      }

      match /shapes/{shapeId} {
        allow read:  if isBoardMember(boardId) || isEmbedViewer(boardId);
        allow write: if isBoardEditor(boardId) || isEmbedEditor(boardId);
      }

      // No embed write: the image BYTES are member-gated in storage.rules, so an
      // embed editor could only ever create a document pointing at an object it
      // cannot upload or read. Editor-only until storage.rules matches.
      match /images/{imageId} {
        allow read:  if isBoardMember(boardId) || isEmbedViewer(boardId);
        allow write: if isBoardEditor(boardId);
      }

      // Voice notes (Month 5, ROADMAP.md:583-587 — roadmap item 9; Month 6 —
      // the Pro-tier gate). Same member-read / editor-write gate as every
      // other canvas-content subcollection above, PLUS `boardOnPaidPlan` on
      // create: voice notes are billed Pro-tier, and this is what actually
      // enforces it server-side now (see the updated header on
      // src/services/audioService.ts's `canRecordVoiceNotes` — it is an
      // affordance gate now, not the only enforcement). The matching
      // storage.rules block for the audio bytes still carries the old
      // caveat; closing that is tracked separately.
      //
      // Gated on CREATE only, not update/delete: a workspace that downgrades
      // after notes already exist must still let its editors delete (or, if
      // ever added, edit) those notes — bricking existing content on a
      // downgrade is not this gate's job, only stopping NEW Pro-tier usage
      // on a free plan is.
      //
      // Read-budget note: `boardOnPaidPlan` → `planOfBoard` → `planOfWorkspace`
      // is a SECOND `get()` of this same board doc (isBoardEditor's own
      // `get()`, just above, is the first) plus an `exists()` + `get()` of
      // the workspace doc. Same as the seat cap's own note on this: the
      // rules engine caches document access within one evaluation, so this
      // adds no new read beyond the board+workspace docs isBoardEditor
      // already touches — but it's one more `get()`-bearing predicate on
      // this match, worth knowing about before adding a third.
      // No embed write, for the same reason as images: the audio bytes are
      // member-gated in storage.rules.
      match /audio/{audioId} {
        allow read:   if isBoardMember(boardId) || isEmbedViewer(boardId);
        allow create: if isBoardEditor(boardId) && boardOnPaidPlan(boardId);
        allow update, delete: if isBoardEditor(boardId);
      }

      match /snapshots/{snapshotId} {
        allow read:  if isBoardMember(boardId) || isEmbedViewer(boardId);
        allow write: if isBoardEditor(boardId) || isEmbedEditor(boardId);
      }

      // OCR memoization cache (Month 4, Phase 10). The handwriting-OCR function
      // keys a result by a hash of the selected stroke ids so a re-run is free.
      // Written ONLY by the Cloud Function via the Admin SDK (which bypasses these
      // rules); a client write is denied here, like aiUsage/aiLog. Any board
      // member may read so the client can surface a cached result.
      match /ocrCache/{hash} {
        allow read:  if isBoardMember(boardId);
        allow write: if false;
      }

      // Comments (Phase 7) anchored to canvas elements. Read follows board access
      // (any member); creating a comment or appending a reply/resolve requires the
      // commenter role (a viewer is read-only here too). The author is pinned to the
      // caller on create. Delete is the comment's author or a board admin (moderation).
      // create/update share isBoardCommenter; the author-pin only applies on create.
      match /comments/{commentId} {
        allow read:   if isBoardMember(boardId);
        allow create: if isBoardCommenter(boardId) &&
                        request.resource.data.authorId == request.auth.uid;
        allow update: if isBoardCommenter(boardId);
        allow delete: if isBoardAdmin(boardId) ||
                        (isBoardCommenter(boardId) &&
                         resource.data.authorId == request.auth.uid);
      }

      // Reactions (Month 6) — 👍 ❤️ ❓ ⭐ 💡 anchored to canvas elements.
      // Reuses isBoardCommenter directly (same commenter+ boundary as
      // comments above, including its legacy-board tolerance and per-board
      // override floor-capping) rather than a second write-role predicate.
      //
      // UNLIKE comments: no update — react/un-react is create/delete only,
      // there is no body to edit or thread to resolve. Delete DOES carry the
      // same admin-moderation arm comments' delete has, though, for a reason
      // comments' delete rule doesn't need to worry about: clearBoardReactions
      // (reactionService.ts) batch-deletes every reaction on the board as
      // part of "clear board" (app/board/[id].tsx), and a Firestore batched
      // write is atomic — ONE reaction the clearing admin doesn't own would
      // reject the WHOLE batch and leave the board half-cleared (elements and
      // comments already gone, reactions not). `isBoardAdmin` closes that
      // exactly like it does for comments' own moderation delete.
      //
      // The document id `{elementId}_{emoji}_{userId}` (reactionService.ts)
      // is the UNIQUENESS constraint (one user cannot double-react with the
      // same emoji on the same element). It is bound to the fields below by
      // exact-match CONCATENATION, not by splitting the id apart: splitting
      // would mean trusting a fixed `_`-separated segment count, which
      // breaks the moment any segment itself contains an underscore, but
      // rebuilding the expected id from the fields and comparing makes no
      // assumption about how many segments anything has. Without this, the
      // `userId` field check alone still stops one user from reacting AS
      // another, but does nothing to stop that SAME user from creating
      // `el1_👍_me`, `el1_👍_me_2`, `x`, … — every one with a valid `userId`
      // field — which would inflate `countsFor`'s per-(element, emoji) count
      // without bound, permanently (toggleReaction only ever deletes the
      // canonical id). `emoji` is also checked against the fixed 5-value set
      // the client offers, so a create can't seed the collection with
      // anything else for a future reader to have to tolerate.
      match /reactions/{reactionId} {
        allow read:   if isBoardMember(boardId);
        allow create: if isBoardCommenter(boardId) &&
                        request.resource.data.userId == request.auth.uid &&
                        request.resource.data.emoji in ['👍', '❤️', '❓', '⭐', '💡'] &&
                        reactionId == request.resource.data.anchorElementId + '_' +
                                      request.resource.data.emoji + '_' + request.auth.uid;
        allow update: if false;
        allow delete: if isBoardAdmin(boardId) ||
                        (isBoardCommenter(boardId) &&
                         resource.data.userId == request.auth.uid);
      }

      // presence — each user manages only their own presence doc.
      // Month 5: an edit-scoped embed identity is present on the board it is
      // writing to, so it reads presence and writes its OWN doc (keyed by its
      // namespaced uid) — the `isOwner(userId)` guard is what keeps it from
      // impersonating a member's presence. A read-only embed stays out entirely.
      match /presence/{userId} {
        allow read:   if isBoardMember(boardId) || isEmbedEditor(boardId);
        allow write:  if (isBoardMember(boardId) || isEmbedEditor(boardId)) && isOwner(userId);
      }

      // Live cursors (Month 4, Phase 6) — ephemeral pointer side channel. Any
      // board member reads; each user writes only their own cursor doc. Kept off
      // the paths/* collections so cursor jitter never touches the persisted-
      // state listeners (Appendix A.4). Same own-uid trust model as presence.
      match /cursors/{userId} {
        allow read:   if isBoardMember(boardId) || isEmbedEditor(boardId);
        allow write:  if (isBoardMember(boardId) || isEmbedEditor(boardId)) && isOwner(userId);
      }
    }

    // ── sessions ──────────────────────────────────────────────────────────────
    // Phase 4 (multi-tenancy). Sessions inherit a workspaceId from their board.
    // A workspace member can read sessions in their workspace; the creator and
    // participants still read directly, and the joinCode public-lookup path is
    // unchanged (needed for join-by-code). Migration-tolerant on READ: a legacy
    // session with no workspaceId keeps the pre-Phase-4 read behavior. Creates are
    // Cloud-Function-only as of M5 (see the create rule below), and the function
    // requires a workspaceId — so no new workspace-less session can appear, but
    // existing ones stay readable.
    // TODO(phase-9-cutover): remove the `workspaceId == null` read tolerance once
    // the migration has stamped every session and the staging soak closes.
    match /sessions/{sessionId} {
      allow read:   if isSignedIn() && (
                      request.auth.uid == resource.data.createdById ||
                      request.auth.uid in resource.data.participantIds ||
                      isMemberOfWorkspace(resource.data.get('workspaceId', null)) ||
                      resource.data.joinCode != null
                    );
      // Creating a session is Cloud-Function-only (functions/src/callable/createSession.ts).
      // The function bumps the workspace's monthly session counter and writes the
      // session in one transaction, then writes with the Admin SDK, which bypasses
      // these rules. Denied here for two reasons a rules predicate cannot cover:
      // rules cannot read a monthly counter to enforce sessions/period, and a
      // client create could pick its own `joinCode` (the function generates one
      // server-side). Reads, updates, the joinCode self-join and delete are all
      // unchanged. See the deploy-order warning at the top of this file.
      allow create: if false;
      allow update: if isSignedIn() && (
                      request.auth.uid == resource.data.createdById ||
                      (
                        resource.data.joinCode != null &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds']) &&
                        request.resource.data.participantIds.hasAll(resource.data.participantIds) &&
                        request.resource.data.participantIds.size() == resource.data.participantIds.size() + 1 &&
                        request.resource.data.participantIds.hasAny([request.auth.uid])
                      )
                    );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.createdById;
    }

    // ── friendRequests ────────────────────────────────────────────────────────
    match /friendRequests/{reqId} {
      allow read:   if isSignedIn() && (
                      request.auth.uid == resource.data.fromId ||
                      request.auth.uid == resource.data.toId
                    );
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.fromId;
      // only the recipient updates status (accept/reject); sender can retract
      allow update: if isSignedIn() && (
                      request.auth.uid == resource.data.toId ||
                      request.auth.uid == resource.data.fromId
                    );
      allow delete: if isSignedIn() && (
                      request.auth.uid == resource.data.fromId ||
                      request.auth.uid == resource.data.toId
                    );
    }

  }
}
