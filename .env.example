# Firebase configuration — production injection (Month 2, Phase 1).
#
# In development these are read from `expo.extra.firebase` in app.json (committed
# dev project). For a production build, set these EXPO_PUBLIC_* vars (in EAS build
# secrets or a local `.env`, which is gitignored) — they override the app.json
# values. Expo inlines EXPO_PUBLIC_* vars into the bundle at build time.
#
# The Firebase web apiKey is a public client identifier, not a secret; access is
# gated by Firestore/Storage security rules.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Sentry error reporting (Month 2, Phase 2).
#
# EXPO_PUBLIC_SENTRY_DSN is read at runtime by src/lib/errorReporting.ts. When set
# (standalone preview/production builds), exceptions forward to Sentry; when empty
# (local dev / Expo Go) the seam falls back to console logging. The DSN is a public
# client identifier, not a secret.
EXPO_PUBLIC_SENTRY_DSN=

# SENTRY_AUTH_TOKEN is used at BUILD time only (by the Sentry Expo config plugin) to
# upload source maps for readable stack traces. It IS a secret — set it as an EAS
# secret (`eas secret:create`), never commit it.
SENTRY_AUTH_TOKEN=

# Google Sign-In OAuth client IDs (Month 3, Phase 11).
#
# Created in the Google Cloud Console (one OAuth client per platform) for the same
# project as Firebase. Read by src/services/authProviders.ts; inlined into the
# bundle at build time. While blank, getProvider("google").isAvailable is false and
# the "Continue with Google" button stays hidden — so leaving these empty is safe.
#
# These are public client identifiers, not secrets. The OAuth redirect only works in
# a native build (TestFlight / Play internal), not Expo Go — register the iOS
# reverse-client-id URL scheme and the Android signing SHA-1 in the console.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# AI gateway cutover (Month 4, Phase 1).
#
# When "1", the client calls the `generateSummary` Cloud Function (no OpenAI key on
# device). When unset/0 (the default), it uses the legacy direct-OpenAI path with a
# client-held key. Leave OFF until the function is deployed and verified in prod
# (see docs/functions-deploy-runbook.md), then flip to "1" to cut over. The OpenAI
# key itself is NOT set here — it lives only in the Functions runtime secret
# (`firebase functions:secrets:set OPENAI_API_KEY`), never in the client bundle.
EXPO_PUBLIC_AI_GATEWAY=

# Explain selection (Month 4, Phase 11).
#
# When "1", exposes the "Explain this" affordance on a board selection and calls
# the `explainSelection` Cloud Function. Leave OFF until the function is deployed.
# Rides the same gateway as summaries, so it is only meaningful with
# EXPO_PUBLIC_AI_GATEWAY=1.
EXPO_PUBLIC_EXPLAIN=

# Text → diagram (Month 4, Phase 12).
#
# When "1", exposes the "Diagram" prompt affordance on a board and calls the
# `textToDiagram` Cloud Function (returns Mermaid, parsed client-side into native
# shapes). Leave OFF until the function is deployed. Rides the same gateway as
# summaries, so it is only meaningful with EXPO_PUBLIC_AI_GATEWAY=1.
EXPO_PUBLIC_DIAGRAM=
